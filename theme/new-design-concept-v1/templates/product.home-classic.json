    "704_features_N36W7D": {
      "type": "704-features",
      "name": "704-features",
      "settings": {
        "video_mp4": "https://cdn.shopify.com/videos/c/o/v/7d49cb2ed2824c469fa5c5e26c432506.mp4",
        "video_webm": "",
        "poster_image": "shopify://shop_images/0001_c7e5edeb-a300-46ab-814c-3d917cfd3251.png",
        "video_alt_text": "Product feature video",
        "video_bitrate": "medium",
        "video_width": 220,
        "video_height": 490,
        "headline": "Mushroom Science Meets Happy Hour",
        "subheadline": "Patent Pending Formula",
        "description": "Taking over a decade of experience working with mushrooms, we have perfected mushroom science to give you the feel good, stress melting effects of a gentle buzz without the baggage. No trippy ingredients hiding here.",
        "button_text": "Learn More",
        "button_link": "",
        "feature_1_number": "01",
        "feature_1_title": "Mushrooms work like your body",
        "feature_1_text": "When you exercise or laugh, your body makes endorphins, natural chemicals that lift your mood. Mushrooms do something similar. Under different conditions, they create their own feel-good compounds.",
        "feature_2_number": "02",
        "feature_2_title": "We reverse-engineered the buzz",
        "feature_2_text": "We studied what actually makes alcohol feel good, the chemistry behind the social, relaxed vibe and created the right conditions for the mushrooms to produce the key actives in enough quantity to synergistically work together with our other ingredients.",
        "feature_3_number": "03",
        "feature_3_title": "The result: TIPSY AF.",
        "feature_3_text": "After years of research and testing, we captured the best part of drinking, the mood, the ease, the vibe powered by mushroom science and other synergistic ingredients.",
        "heading_size": 74,
