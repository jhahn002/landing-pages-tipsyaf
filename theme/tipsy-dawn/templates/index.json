    "faq": {
      "type": "tpm-faq",
      "settings": {},
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How many should I drink?",
            "answer": "<p>One can is one serving. Start with one, give it 10–15 minutes, and have another if you want to turn it up. Each can lasts about an hour.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Can I drive after drinking it?",
            "answer": "<p>We don't recommend it. Your blood alcohol will be zero, but you can still be considered under the influence. Once the feeling has passed, you can drive.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Is it legal? Who is it for?",
            "answer": "<p>Everything in it is legal, and we ship to all 50 states. TIPSY AF is designed for adults 18 and over.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "How does the trial work?",
            "answer": "<p>You get 6 cans for $29.94. We remind you on day 25. On day 28 it renews as a 12-pack at $49.80/mo plus $2.99 shipping. You can cancel anytime.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "What if I don't like it?",
            "answer": "<p>Email <a href=\"mailto:hey@gettipsy.com\">hey@gettipsy.com</a> within 100 days of your order for a full refund, even on opened cans. Shipping fees aren't refunded unless the problem was on our end. <a href=\"/pages/returns-refunds-policy\">Full policy</a>.</p>"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "What's in each can?",
            "answer": "<p><strong>Blood Orange Margarita</strong> (30 calories, 8g sugar): Filtered Water, Organic Cane Sugar, Orange Juice Concentrate, Natural Flavors, Botanical Extracts, Key Lime Juice Concentrate, Citric Acid, Proprietary Mushroom Blend (Chaga, Maitake, Shiitake, Reishi, Turkey Tail), L-Theanine, GABA, Theobromine, Stevia Extract (Reb M).</p><p><strong>Pineapple Martini</strong> (35 calories, 9g sugar): Carbonated Water, Sugar, Pineapple Juice Concentrate, Natural Flavors, Botanical Extracts, Citric Acid, Proprietary Mushroom Blend (Chaga, Maitake, Shiitake, Reishi, Turkey Tail), Beta Carotene (Color), L-Theanine, GABA, Theobromine, Stevia Leaf Extract.</p>"
          }
        }
