        "faq_item_w676i9": {
          "type": "faq_item",
          "name": "Product Details",
          "settings": {
            "question": "Product Details",
            "answer": "<p></p><ul><li><strong>DEVELOPED BY MUSHROOM VETERANS:</strong> born from the OGs of mushroom innovation. After raising over <span style=\"text-decoration:underline\"><strong>$220 million</strong></span> to bring functional mushroom science to the mainstream, we are back with our latest breakthrough, a feel-good zero proof cocktail powered by years of R&D.<br/><br/></li><li><strong>ZERO-PROOF WITHOUT THE SHORTCUTS</strong>  all the ritual, flavor, and vibe of drinking, minus the booze, bad decisions, or questionably legal ingredients.<br/><br/></li><li><strong>STACKABLE AF </strong>everyone feels it different, try a serving, see how you feel, stack as needed. Enjoy the stress melting, mood boosting wave come over you.<br/><br/></li><li><strong>BUILT-IN OFF-SWITCH</strong> once it’s done, it’s done. Go out, chill, or hit the gym right after.<br/><br/></li><li><strong>ZERO HANGOVER</strong> feel good now <em>and</em> tomorrow morning. No recovery time, no guilt spiral.<br/><br/></li><li><strong>100-DAY HAPPINESS GUARANTEE</strong> if it doesn’t make your night better, send it back. No hard feelings.</li></ul><p></p>",
            "default_open": true
          }
        },
