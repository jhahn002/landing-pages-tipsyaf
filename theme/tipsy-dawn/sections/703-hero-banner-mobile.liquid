      {%- if flavor_blocks.size > 0 -%}
        {%- for block in flavor_blocks -%}
          <div class="s703-panel-flavor{% if forloop.first %} is-active{% endif %}"
               data-panel-flavor="{{ block.settings.flavor_name | escape }}">
