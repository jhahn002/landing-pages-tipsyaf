{% comment %}
  Section: 703 - Hero Banner Mobile
  Purpose: Mobile product detail hero with carousel, sticky images, subscription options
  Performance Mode: Relaxed
  CLEAN REWRITE - Fixed sticky scroll behavior
{% endcomment %}

<link rel="preload" href="https://cdn.shopify.com/s/files/1/0647/7696/2256/files/LeagueGothic-Regular.woff2?v=1764966695" as="font" type="font/woff2" crossorigin>

<style>
  /* League Gothic Font - multiple weight declarations for compatibility */
  @font-face {
    font-family: 'League Gothic';
    src: url('https://cdn.shopify.com/s/files/1/0647/7696/2256/files/LeagueGothic-Regular.woff2?v=1764966695') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  /* Force parent containers to allow sticky */
  .shopify-section,
  .page-width,
  main {
    overflow: visible !important;
  }

  @font-face {
    font-family: 'Coolvetica Heavy Compressed';
    src: url('https://cdn.shopify.com/s/files/1/0647/7696/2256/files/Coolvetica_Hv_Comp.woff2?v=1758909708') format('woff2');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  /* === ROOT SECTION === */
  .section-703-hero-banner-mobile {
    --s703-bg-color: {{ section.settings.background_color }};
    --s703-text-color: {{ section.settings.text_color }};
    --s703-accent-color: {{ section.settings.accent_color }};
    --s703-heading-line-height: {{ section.settings.heading_line_height }}%;
    --s703-icon-stroke-color: {{ section.settings.icon_stroke_color }};
    --s703-icon-stroke-width: {{ section.settings.icon_stroke_width }}px;
    --s703-benefits-bg: {{ section.settings.benefits_bg_color }};
    --s703-quote-line-height: {{ section.settings.quote_line_height }};
    
    position: relative;
    background-color: var(--s703-bg-color);
    color: var(--s703-text-color);
  }

  /* === MOBILE LAYOUT (DEFAULT) === */
  .s703-container {
    width: 100%;
  }

  /* Mobile-only: Reorder content so carousel appears after description */
  @media (max-width: 640px) {
    .s703-container {
      display: grid;
      grid-template-columns: 1fr;
      padding-left: 15px;
      padding-right: 15px;
    }

    /* Position elements in grid */
    .s703-testimonial {
      grid-row: 1;
    }

    .s703-heading {
      grid-row: 2;
    }

    .s703-description {
      grid-row: 3;
      margin-bottom: 1.5rem;
    }

    /* Carousel appears after description */
    .s703-left-column {
      grid-row: 4;
      margin-bottom: 1.5rem;
    }

    /* Right column contains everything else */
    .s703-right-column {
      display: contents;
    }

    .s703-icon-badges {
      grid-row: 5;
    }

    .s703-info-buttons {
      grid-row: 6;
    }

    .s703-purchase-options {
      grid-row: 7;
    }

    .s703-delivery-info {
      grid-row: 8;
    }

    .s703-guarantee {
      grid-row: 9;
    }

    .s703-accordion-section {
      grid-row: auto;
    }
  }

  /* === DESKTOP LAYOUT === */
  @media (min-width: 768px) {
    .s703-container {
      display: flex;
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
      align-items: flex-start;
    }
    
    .s703-left-column {
      flex: 0 0 50%;
      position: sticky;
      top: 2rem;
      align-self: flex-start;
    }
    
    .s703-right-column {
      flex: 0 0 50%;
      width: 100%;
      max-width: 525px;
    }
    
    .s703-flavors-section {
      margin: 0;
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .s703-skeleton,
    .s703-stock-dot {
      animation: none;
    }
  }

  /* === CAROUSEL === */
  .s703-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: transparent;
    border-radius: {{ section.settings.carousel_border_radius }}px;
    padding-top: {{ section.settings.carousel_top_padding }}px;
  }

  .s703-carousel {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .s703-carousel-slide {
    min-width: 100%;
    position: relative;
    aspect-ratio: 3/4;
  }

  .s703-carousel-slide img,
  .s703-carousel-slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ section.settings.carousel_border_radius }}px;
  }

  /* Carousel Navigation */
  .s703-carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: all 0.2s ease;
    opacity: 0.6;
  }

  .s703-carousel-nav:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.5);
  }

  .s703-carousel-nav-prev { left: 1rem; }
  .s703-carousel-nav-next { right: 1rem; }

  .s703-carousel-nav svg {
    width: 16px;
    height: 16px;
    stroke: white;
    stroke-width: 2;
    fill: none;
  }

  .s703-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .s703-badge-icon {
    width: 1rem;
    height: 1rem;
  }

  .s703-carousel-dots {
    position: absolute;
    bottom: {{ section.settings.carousel_dots_bottom }}px;
    left: 1rem;
    display: flex;
    gap: 0.25rem;
    z-index: 2;
    background: rgba(40, 40, 39, 0.75);
    padding: 0.25rem 0.5rem;
    border-radius: 100px;
  }

  .s703-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .s703-dot.active {
    background: rgba(0, 0, 0, 1);
  }

  /* === STATIC MEDIA === */
  .s703-fixed-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.static_gap }}px;
    margin-top: {{ section.settings.static_gap }}px;
  }

  .s703-fixed-media-item {
    height: {{ section.settings.static_image_height }}px;
    overflow: hidden;
    border-radius: {{ section.settings.static_border_radius }}px;
  }

  .s703-fixed-media-item.full-width {
    grid-column: 1 / -1;
  }

  .s703-fixed-media-item img,
  .s703-fixed-media-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .s703-fixed-media {
      {% unless section.settings.show_static_on_mobile %}
        display: none;
      {% endunless %}
    }
  }

  /* === RIGHT COLUMN CONTENT === */
  .s703-right-column {
    padding: 2rem 1rem;
    width: 100%;
    max-width: 525px;
    margin: 0 auto;
  }

  /* Testimonial */
  .s703-testimonial {
    margin-bottom: {{ section.settings.testimonial_bottom_spacing }}px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .s703-stars {
    display: flex;
    gap: {{ section.settings.star_spacing }}px;
    color:#FB5820;
    font-size: {{ section.settings.star_size }}px;
    flex-shrink: 0;
  }

  .s703-quote {
    font-size: {{ section.settings.testimonial_font_size }}px;
    font-style: italic;
    color: var(--s703-text-color);
    margin: 0;
    line-height: var(--s703-quote-line-height);
  }

  /* Heading */
  .s703-heading {
    font-family: 'Coolvetica Heavy Compressed', 'Impact', sans-serif;
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 900;
    line-height: var(--s703-heading-line-height);
    text-transform: uppercase;
    margin: {{ section.settings.heading_top_spacing }}px 0 1rem 0;
    letter-spacing: calc({{ section.settings.heading_letter_spacing }} / 100 * 1em);
  }

  /* Description */
  .s703-description {
    font-size: {{ section.settings.description_font_size }}px;
    line-height: {{ section.settings.description_line_height }};
    margin-bottom: 1.5rem;
  }

  /* === ICON BADGES === */
  .s703-icon-badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .s703-icon-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .s703-icon-circle {
    width: {{ section.settings.icon_circle_size }}px;
    height: {{ section.settings.icon_circle_size }}px;
    border-radius: 50%;
    border: var(--s703-icon-stroke-width) solid var(--s703-icon-stroke-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.icon_padding }}px;
  }

  .s703-icon-circle img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .s703-icon-label {
    font-size: {{ section.settings.features_font_size }}px;
    font-weight: 600;
    line-height: 1.2;
  }

  /* === INFO BUTTONS === */
  .s703-info-buttons {
    display: flex;
    gap: 0.75rem;
    margin-bottom: {{ section.settings.info_buttons_bottom_spacing }}px;
  }

  .s703-info-btn {
    padding: 0.5rem 1rem;
    border: 1px solid currentColor;
    background: transparent;
    border-radius: 0.25rem;
    font-size: {{ section.settings.info_button_font_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .s703-info-btn:hover {
    background: var(--s703-accent-color);
    color: white;
    border-color: var(--s703-accent-color);
  }

  .s703-info-btn-icon {
    font-size: 1.25em;
    line-height: 1;
  }

  /* === PURCHASE OPTIONS MODULE === */
  .s703-purchase-options {
    margin-top: {{ section.settings.subscription_wrapper_top_spacing }}px;
    margin-bottom: 1.5rem;
  }

  /* === TRIAL OFFER BOX === */
  .s703-trial-wrapper {
    border: 4px solid {{ section.settings.trial_header_bg | default: '#2A2552' }};
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 16px;
    background: #ffffff;
  }

  .s703-trial-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: {{ section.settings.trial_header_bg | default: '#2A2552' }};
    border-radius: 16px 16px 0 0;
  }

  .s703-trial-label {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ section.settings.trial_header_bg | default: '#2A2552' }};
    background: #ffffff;
    padding: 6px 16px;
    border-radius: 100px;
    margin: 0;
    line-height: 1.2;
  }

  .s703-trial-badge {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #ffffff;
    line-height: 1;
  }

  .s703-trial-content {
    padding: 12px 16px 16px 16px;
  }

  .s703-trial-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .s703-trial-title-left {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .s703-trial-badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .s703-trial-title {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: {{ section.settings.trial_title_font_size }}px !important;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000000;
    margin: 0;
    line-height: 1;
  }

  .s703-trial-price {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: {{ section.settings.trial_price_font_size }}px !important;
    font-weight: 400;
    color: #000000;
    line-height: 1;
  }

  /* Per-flavour panel copy. Every flavour's text is rendered and the chosen
     one revealed, so switching flavour needs no fetch and works offline. */
  .s703-panel-flavor { display: none; }
  .s703-panel-flavor.is-active { display: block; }
  .s703-flavor-selector.in-panel { margin: 0 0 14px; }

  /* The picker belongs to whichever option is chosen, so the flavour reads as
     part of that purchase rather than a separate control sitting below both. */
  .s703-option-wrapper .s703-flavor-selector.in-option { display: none; }
  .s703-option-wrapper.selected .s703-flavor-selector.in-option {
    display: block;
    /* auto, not the base rule's 100% - that is 100% of the option's content box
       and the side margins then push it past the edge. */
    width: auto;
    margin: 10px 12px 12px;
  }

  /* ===== FLAVOR SELECTOR (ported from 703a-hero-banner) ===== */
  .s703-flavor-selector {
    width: 100%;
    position: relative;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .s703-flavor-selector.in-trial {
    margin-bottom: 12px;
  }
  .s703-flavor-selected {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1.5px solid #E0E0E0;
    border-radius: 12px;
    background: #FFFFFF;
    cursor: pointer;
    user-select: none;
    transition: border-color 0.15s;
  }
  .s703-flavor-selected:hover { border-color: #BBBBBB; }
  .s703-flavor-swatch {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
  }
  .s703-flavor-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .s703-flavor-name {
    font-size: 14px;
    font-weight: 700;
    color: #1A1A2E;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }
  .s703-flavor-desc {
    font-size: 12px;
    font-weight: 400;
    color: #777777;
    line-height: 1.3;
  }
  .s703-flavor-chevron {
    font-size: 13px;
    font-weight: 700;
    color: #888888;
    flex-shrink: 0;
    line-height: 1;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .s703-flavor-dropdown {
    position: relative;
    margin-top: 6px;
    background: #FFFFFF;
    border: 1.5px solid #E0E0E0;
    border-radius: 12px;
    overflow: hidden;
    z-index: 200;
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  }
  .s703-flavor-option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    cursor: pointer;
    transition: background-color 0.12s;
    border-bottom: 1px solid #F5F5F5;
  }
  .s703-flavor-option:last-of-type { border-bottom: none; }
  .s703-flavor-option:hover { background-color: #F7F7F7; }
  .s703-flavor-option.is-active { background-color: #F3F3F3; }
  .s703-flavor-option-swatch {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
  }
  .s703-flavor-option-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .s703-flavor-option-name {
    font-size: 14px;
    font-weight: 700;
    color: #1A1A2E;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }
  .s703-flavor-option-desc {
    font-size: 12px;
    font-weight: 400;
    color: #777777;
    line-height: 1.3;
  }
  .s703-flavor-footer {
    padding: 13px 16px;
    text-align: center;
    background-color: #F5F5F5;
    border-top: 1px solid #EEEEEE;
    font-size: 11px;
    font-weight: 700;
    color: #888888;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .s703-flavor-footer a { color: #555555; text-decoration: none; }
  .s703-flavor-footer a:hover { color: #1A1A2E; }

  .s703-trial-description {
    font-size: 13px;
    line-height: 1.4;
    color: #333333;
    margin-bottom: 12px;
  }

  .s703-trial-cta {
    width: 100%;
    background: {{ section.settings.trial_cta_bg_color }};
    color: {{ section.settings.trial_cta_text_color }};
    border: none;
    padding: 14px 24px;
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: {{ section.settings.trial_cta_font_size }}px !important;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 8px;
    line-height: 1;
  }

  .s703-trial-cta:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .s703-trial-upgrade-note {
    font-size: 12px;
    color: #666666;
    text-align: center;
    margin-bottom: 8px;
    line-height: 1.4;
    font-style: italic;
  }

  /* === TRIAL TIMELINE === */
  .s703-trial-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    background: #f5f5f5;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #D2D2D2;
  }

  .s703-timeline-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid #e0e0e0;
  }

  .s703-timeline-item:last-child {
    border-bottom: none;
  }

  .s703-timeline-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .s703-timeline-icon img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .s703-timeline-icon svg {
    width: 20px;
    height: 20px;
    stroke: #000000;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .s703-timeline-text {
    flex: 1;
    padding-top: 2px;
  }

  .s703-timeline-day {
    font-size: 14px;
    font-weight: 700;
    color: #000000;
    line-height: 1.3;
  }

  .s703-timeline-day span {
    font-weight: 400;
  }

  .s703-timeline-desc {
    font-size: 13px;
    color:rgb(54, 54, 54);
    line-height: 1.4;
  }

  /* === RADIO OPTION BOXES === */
  .s703-option-wrapper {
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 12px;
    background: #ffffff;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .s703-option-wrapper:hover {
    border-color: #999999;
  }

  .s703-option-wrapper.selected {
    border-color: #000000;
    border-width: 2px;
  }

  .s703-option-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
  }

  /* Radio Button */
  .s703-radio-outer {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    border: 2px solid #cccccc;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
    cursor: pointer;
    position: relative;
    box-sizing: border-box;
  }

  .s703-option-wrapper.selected .s703-radio-outer {
    border-color: #000000;
  }

  .s703-radio-inner {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    background-color: #000000;
    border-radius: 50%;
    display: block;
    opacity: 0;
    transform: scale(0);
    transition: all 0.15s ease;
  }

  .s703-option-wrapper.selected .s703-radio-inner {
    opacity: 1 !important;
    transform: scale(1) !important;
    display: block !important;
  }

  .s703-option-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .s703-option-title-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .s703-option-title {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: {{ section.settings.option_title_font_size }}px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000000;
    margin: 0;
    line-height: 1;
  }

  .s703-option-pack-count {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #666666;
    line-height: 1;
  }

  .s703-option-badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .s703-option-badge {
    background: {{ section.settings.option_badge_bg_color }};
    color: {{ section.settings.option_badge_text_color }};
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 0.5px;
  }

  .s703-option-badge.autoship-badge-2 {
    background: #E0D4F7;
  }

  .s703-option-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    margin-left: auto;
  }

  .s703-option-price-main {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: {{ section.settings.option_price_font_size }}px;
    font-weight: 400;
    color: #000000;
    line-height: 1;
  }

  .s703-option-price-per {
    font-size: 13px;
    font-weight: 400;
    color: #666666;
    line-height: 1;
  }

  /* === QUANTITY SELECTOR === */
  .s703-quantity-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  .s703-pack-selector {
    display: flex;
    align-items: center;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    overflow: hidden;
  }

  .s703-pack-qty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    background: #ffffff;
    min-width: 50px;
  }

  .s703-pack-number {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: 24px;
    font-weight: 400;
    color: #000000;
    line-height: 1;
  }

  .s703-pack-label {
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: 10px;
    font-weight: 400;
    text-transform: uppercase;
    color: #666666;
    line-height: 1;
  }

  .s703-pack-controls {
    display: flex;
    flex-direction: column;
    border-left: 1px solid #e0e0e0;
  }

  .s703-pack-btn {
    width: 28px;
    height: 28px;
    background: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .s703-pack-btn:first-child {
    border-bottom: 1px solid #e0e0e0;
  }

  .s703-pack-btn:hover {
    background: #f5f5f5;
  }

  .s703-pack-btn svg {
    width: 12px;
    height: 12px;
    stroke: #000000;
    stroke-width: 2;
    fill: none;
  }

  /* Main CTA Button */
  .s703-main-cta {
    flex: 1;
    background: {{ section.settings.main_cta_bg_color }};
    color: {{ section.settings.main_cta_text_color }};
    border: none;
    padding: 16px 32px;
    font-family: 'League Gothic', 'Impact', sans-serif !important;
    font-size: {{ section.settings.main_cta_font_size }}px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    line-height: 1;
  }

  .s703-main-cta:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .s703-main-cta svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  /* Legacy support - keep benefits section */
  .s703-subscription-benefits {
    background: var(--s703-benefits-bg);
    padding: 1rem 1rem 15px 1rem;
    display: none;
  }

  .s703-subscription-benefits.active {
    display: block;
  }

  .s703-benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  .s703-benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 14px;
    line-height: 1.5;
  }

  .s703-benefit-icon {
    width: 20px;
    height: 20px;
    background: {{ section.settings.subscription_bg_start }};
    border-radius: 50%;
    color: white;
    flex-shrink: 0;
    margin-top: 0.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .s703-benefit-icon svg {
    width: 12px;
    height: 12px;
  }

  .s703-benefit-text {
    flex: 1;
  }

  /* === FLAVORS SECTION === */
  .s703-flavors-section {
    background: var(--s703-benefits-bg);
    padding: 0 1rem 0 1rem;
    margin: 0 -1rem 0 -1rem;
    display: none;
  }

  .s703-flavors-section.active {
    display: block;
  }

  .s703-flavor-item {
    background: white;
    border-radius: {{ section.settings.flavor_item_border_radius }}px;
    border: 1px solid #E0E0E0;
    padding: {{ section.settings.flavor_item_padding_top }}px 15px {{ section.settings.flavor_item_padding_bottom }}px 15px;
    margin-bottom: {{ section.settings.flavor_item_spacing }}px;
    display: grid;
    grid-template-columns: {{ section.settings.flavor_image_size }}px 1fr auto;
    grid-template-rows: auto auto;
    gap: 0 19px;
    align-items: center;
    min-height: {{ section.settings.flavor_image_size }}px;
  }

  .s703-flavor-item:last-child {
    margin-bottom: 0;
  }

  .s703-flavor-image {
    grid-row: 1 / 3;
    grid-column: 1 / 2;
    width: {{ section.settings.flavor_image_size }}px;
    height: {{ section.settings.flavor_image_size }}px;
    object-fit: cover;
    border-radius: 4px;
  }

  .s703-flavor-info {
    grid-row: 1 / 2;
    grid-column: 2 / 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }

  .s703-flavor-name {
    font-family: 'Coolvetica Heavy Compressed', 'Impact', sans-serif;
    font-size: {{ section.settings.flavor_name_font_size }}px;
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .s703-flavor-rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .s703-flavor-stars {
    display: flex;
    gap: 1px;
    color: #FB5820;
    font-size: {{ section.settings.flavor_star_size }}px;
    line-height: 1;
  }

  .s703-flavor-rating-number {
    color: #000;
    font-weight: 400;
    font-size: {{ section.settings.flavor_rating_font_size }}px;
    line-height: 1;
  }

  .s703-flavor-pack-price {
    grid-row: 2 / 3;
    grid-column: 2 / 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: {{ section.settings.flavor_pack_price_font_size }}px;
    color: #000;
  }

  .s703-flavor-separator {
    color: #000;
  }

  /* Flavor Controls */
  .s703-flavor-controls {
    grid-row: 1 / 3;
    grid-column: 3 / 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 95px;
    min-width: 95px;
    max-width: 95px;
    align-self: center;
  }

  .s703-flavor-add-btn {
    width: 95px;
    height: 31px;
    background: {{ section.settings.subscription_bg_start }};
    color: white;
    border: none;
    border-radius: 100px;
    font-size: {{ section.settings.add_button_font_size }}px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 1;
    transform: scale(1);
  }

  .s703-flavor-add-btn:hover {
    background: {{ section.settings.subscription_bg_end }};
  }

  .s703-flavor-add-btn.hidden {
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
    position: absolute;
  }

  .s703-flavor-quantity {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    width: 95px;
    height: 31px;
    opacity: 0;
    transform: scale(0.9);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .s703-flavor-quantity.active {
    display: flex;
    opacity: 1;
    transform: scale(1);
  }

  .s703-qty-btn {
    width: 31px;
    height: 31px;
    background: {{ section.settings.subscription_bg_start }};
    color: white;
    border: none;
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .s703-qty-btn:hover {
    background: {{ section.settings.subscription_bg_end }};
    transform: scale(1.05);
  }

  .s703-qty-btn:active {
    transform: scale(0.95);
  }

  .s703-qty-display {
    text-align: center;
    font-weight: 700;
    font-size: {{ section.settings.qty_display_font_size }}px;
    color: #000;
    line-height: {{ section.settings.qty_display_line_height }};
    flex: 1;
  }

  /* === CTA BUTTON === */
  .s703-cta {
    width: 100%;
    background: var(--s703-cta-bg);
    color: var(--s703-cta-text);
    border: none;
    padding: {{ section.settings.cta_padding_y }}px {{ section.settings.cta_padding_x }}px;
    font-size: {{ section.settings.cta_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: {{ section.settings.cta_bottom_spacing }}px;
  }

  .s703-cta:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .s703-cta:active {
    transform: translateY(0);
  }

  /* === DELIVERY INFO === */
  .s703-delivery-info {
    background: {{ section.settings.delivery_bg_color }};
    border: 1px solid {{ section.settings.delivery_border_color }};
    border-radius: {{ section.settings.delivery_border_radius }}px;
    padding: {{ section.settings.delivery_padding_y }}px {{ section.settings.delivery_padding_x }}px;
    margin-bottom: {{ section.settings.delivery_bottom_spacing }}px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .s703-stock-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .s703-stock-dot {
    width: {{ section.settings.stock_dot_size }}px;
    height: {{ section.settings.stock_dot_size }}px;
    border-radius: 50%;
    flex-shrink: 0;
    animation: s703-pulse-dot 2s ease-in-out infinite;
  }

  @keyframes s703-pulse-dot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.1);
    }
  }

  .s703-stock-text {
    font-size: {{ section.settings.stock_text_size }}px;
    font-weight: 700;
    line-height: 1;
  }

  .s703-delivery-text {
    font-size: {{ section.settings.delivery_text_size }}px;
    line-height: 1.4;
    color: {{ section.settings.delivery_text_color }};
  }

  .s703-delivery-highlight {
    font-weight: 700;
    color: {{ section.settings.delivery_highlight_color }};
  }

  .s703-delivery-countdown {
    font-weight: 700;
    color: {{ section.settings.delivery_countdown_color }};
  }

  /* === GUARANTEE === */
  .s703-guarantee {
    background: {{ section.settings.guarantee_bg_color }};
    border: {{ section.settings.guarantee_border_width }}px {{ section.settings.guarantee_border_style }} {{ section.settings.guarantee_border_color }};
    border-radius: {{ section.settings.guarantee_border_radius }}px;
    padding: {{ section.settings.guarantee_padding }}px;
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .s703-guarantee-icon {
    width: {{ section.settings.guarantee_icon_size }}px;
    height: {{ section.settings.guarantee_icon_size }}px;
    flex-shrink: 0;
  }

  .s703-guarantee-content {
    flex: 1;
  }

  .s703-guarantee-header {
    font-size: {{ section.settings.guarantee_header_size }}px;
    font-weight: 400;
    margin: 0 0 0.25rem 0;
    text-transform: uppercase;
    color: {{ section.settings.guarantee_header_color }};
    letter-spacing: 0.5px;
  }

  .s703-guarantee-title {
    font-size: {{ section.settings.guarantee_title_size }}px;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .s703-guarantee-text {
    font-size: {{ section.settings.guarantee_text_size }}px;
    margin: 0;
    line-height: 1.5;
    color: {{ section.settings.guarantee_text_color }};
  }

  /* === ACCORDION/FAQ === */
  .s703-accordion-section {
    border-top: 1px solid {{ section.settings.accordion_border_color }};
    margin-bottom: 0;
  }

  .s703-accordion-section:last-of-type {
    border-bottom: 1px solid {{ section.settings.accordion_border_color }};
  }

  .s703-accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ section.settings.accordion_header_padding_y }}px {{ section.settings.accordion_header_padding_x }}px;
    background: transparent;
    border: none;
    width: 100%;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease;
  }

  .s703-accordion-header:hover {
    background: {{ section.settings.accordion_hover_bg }};
  }

  .s703-accordion-title {
    font-size: {{ section.settings.accordion_title_size }}px;
    font-weight: {{ section.settings.accordion_title_weight }};
    text-transform: {{ section.settings.accordion_title_transform }};
    letter-spacing: {{ section.settings.accordion_title_spacing }}px;
    margin: 0;
    color: {{ section.settings.accordion_title_color }};
  }

  .s703-accordion-icon {
    width: {{ section.settings.accordion_icon_size }}px;
    height: {{ section.settings.accordion_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ section.settings.accordion_icon_color }};
  }

  .s703-accordion-icon svg {
    width: 100%;
    height: 100%;
  }

  .s703-accordion-header.active .s703-accordion-icon {
    transform: rotate(180deg);
  }

  .s703-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
    padding: 0 {{ section.settings.accordion_header_padding_x }}px;
  }

  .s703-accordion-content.active {
    max-height: 2000px;
    padding: 0 {{ section.settings.accordion_header_padding_x }}px {{ section.settings.accordion_content_padding_bottom }}px {{ section.settings.accordion_header_padding_x }}px;
  }

  .s703-accordion-content-inner {
    font-size: {{ section.settings.accordion_content_size }}px;
    line-height: {{ section.settings.accordion_content_line_height }};
    color: {{ section.settings.accordion_content_color }};
  }

  .s703-accordion-content-inner ul,
  .s703-accordion-content-inner ol {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .s703-accordion-content-inner li {
    margin-bottom: 0.75rem;
  }

  .s703-accordion-content-inner p {
    margin-bottom: 1rem;
  }

  .s703-accordion-content-inner p:last-child {
    margin-bottom: 0;
  }

  /* === SLIDE-OUT PANELS === */
  .s703-panel-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .s703-panel-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* A centred dialog, matching the product page. <dialog> brings its own
     backdrop, focus trap and Esc handling, so the separate overlay div and the
     body-scroll locking the sheet needed are gone. */
  .s703-panel {
    width: min(430px, calc(100vw - 32px));
    max-height: min(80vh, 720px);
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: white;
    overflow: hidden;
  }

  .s703-panel::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .s703-panel-inner {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .s703-panel-header {
    position: sticky;
    top: 0;
    background: white;
    padding: 1rem;
    border-bottom: 1px solid #e0e0e0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
  }

  .s703-panel-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0;
  }

  .s703-panel-close {
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #757575;
  }

  .s703-panel-body-scroll {
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .s703-panel-content {
    padding: 1.5rem;
    font-size: {{ section.settings.panel_content_font_size }}px;
    line-height: 1.6;
  }

  .s703-panel-content h1,
  .s703-panel-content h2,
  .s703-panel-content h3,
  .s703-panel-content h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
  }

  .s703-panel-content h1 { font-size: 2em; }
  .s703-panel-content h2 { font-size: 1.5em; }
  .s703-panel-content h3 { font-size: 1.25em; }
  .s703-panel-content h4 { font-size: 1.1em; }

  .s703-panel-content p {
    margin-bottom: 1rem;
  }

  .s703-panel-content ul,
  .s703-panel-content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .s703-panel-content li {
    margin-bottom: 0.5rem;
  }

  .s703-panel-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  .s703-panel-content th,
  .s703-panel-content td {
    border: 1px solid #e0e0e0;
    padding: 0.75rem;
    text-align: left;
  }

  .s703-panel-content th {
    background: #f5f5f5;
    font-weight: 700;
  }

  .s703-panel-content a {
    color: var(--s703-accent-color);
    text-decoration: underline;
  }

  /* === SKELETON LOADERS === */
  @keyframes s703-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .s703-skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: s703-pulse 2s ease-in-out infinite;
    border-radius: 0.25rem;
  }

  .s703-skeleton-carousel {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: {{ section.settings.carousel_border_radius }}px;
  }

  /* === UTILITY CLASSES === */
  .s703-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
<div class="section-703-hero-banner-mobile" 
     role="main" 
     aria-label="{{ section.settings.heading | escape }}"
     style="--s703-cta-bg: {{ section.settings.cta_bg_color }}; --s703-cta-text: {{ section.settings.cta_text_color }};">
  
  <div class="s703-container">
    
    <!-- ==================== LEFT COLUMN: CAROUSEL & STATIC MEDIA ==================== -->
    <div class="s703-left-column">
      
      {% if section.settings.skeleton_enabled %}
        <div class="s703-skeleton s703-skeleton-carousel" aria-hidden="true"></div>
      {% endif %}
      
      <div class="s703-carousel-wrapper" {% if section.settings.skeleton_enabled %}style="display: none;"{% endif %}>
        
        {% if section.settings.badge_text != blank %}
          <div class="s703-badge">
            {% if section.settings.badge_icon %}
              <img src="{{ section.settings.badge_icon | image_url: width: 32 }}" 
                   alt="" 
                   class="s703-badge-icon" 
                   width="16" 
                   height="16"
                   loading="lazy"
                   decoding="async">
            {% endif %}
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {% endif %}
        
        <div class="s703-carousel" id="s703Carousel" role="region" aria-label="Product images carousel">
          {% for block in section.blocks %}
            {% if block.type == 'carousel_slide' %}
              <div class="s703-carousel-slide" data-slide-index="{{ forloop.index0 }}">
                {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
                  <video 
                    src="{{ block.settings.video_url }}" 
                    {% if block.settings.autoplay %}autoplay muted loop playsinline{% endif %}
                    loading="lazy"
                    aria-label="Product video {{ forloop.index }}">
                  </video>
                {% elsif block.settings.image %}
                  <img 
                    src="{{ block.settings.image | image_url: width: 800 }}" 
                    alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
                    width="800"
                    height="1067"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    decoding="async"
                    {% if forloop.first %}fetchpriority="high"{% endif %}>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        
        {% assign carousel_count = section.blocks | where: 'type', 'carousel_slide' | size %}
        {% if carousel_count > 1 %}
          <button class="s703-carousel-nav s703-carousel-nav-prev" 
                  aria-label="Previous image"
                  onclick="s703PrevSlide()">
            <svg viewBox="0 0 24 24">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          
          <button class="s703-carousel-nav s703-carousel-nav-next" 
