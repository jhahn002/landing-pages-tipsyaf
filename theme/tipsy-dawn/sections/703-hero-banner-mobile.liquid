    {%- if flavor_blocks.size > 0 -%}
      {%- render 's703-flavor-picker', role: 'nutrition', extra_class: ' in-panel', blocks: flavor_blocks, first: first_flavor, footer: section.settings.single_flavor_footer, variety_label: section.settings.variety_pack_label, variety_url: section.settings.variety_pack_url -%}
    {%- endif -%}
