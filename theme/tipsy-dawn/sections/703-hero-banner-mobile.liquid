<script>
(function() {
  'use strict';
  
  // ==================== CONFIGURATION ====================
  const config = {
    cansPerCase: {{ section.settings.cans_per_case }},
    regularPricePerCan: parseFloat('{{ section.settings.regular_price_per_can }}'),
    subscriptionPricePerCan: parseFloat('{{ section.settings.subscription_price_per_can }}'),
    minOrderQty: {{ section.settings.min_order_qty }},
    
    inventoryHigh: {{ section.settings.inventory_high }},
    inventoryMedium: {{ section.settings.inventory_medium }},
    inventoryLow: {{ section.settings.inventory_low }},
    
    nonShippingDays: {{ section.settings.non_shipping_days | json }},
    cutoffHour: {{ section.settings.cutoff_hour }},
    cutoffMinute: {{ section.settings.cutoff_minute }},
    timeZone: '{{ section.settings.time_zone }}',
    minTransitDays: {{ section.settings.min_transit_days }},
    maxTransitDays: {{ section.settings.max_transit_days }},
    
    stockHighText: '{{ section.settings.stock_high_text }}',
    stockMediumText: '{{ section.settings.stock_medium_text }}',
    stockLowText: '{{ section.settings.stock_low_text }}',
    stockOutText: '{{ section.settings.stock_out_text }}',
    stockHighColor: '{{ section.settings.stock_high_color }}',
    stockMediumColor: '{{ section.settings.stock_medium_color }}',
    stockLowColor: '{{ section.settings.stock_low_color }}',
    stockOutColor: '{{ section.settings.stock_out_color }}'
  };
  
  // ==================== INVENTORY DISPLAY ====================
  function getTotalInventory() {
    let total = 0;
    {% for block in section.blocks %}
      {% if block.type == 'flavor' and block.settings.product != blank %}
        {% assign product = block.settings.product %}
        {% assign variant = product.selected_or_first_available_variant %}
        {% if block.settings.variant != blank %}
          {% assign variant = product.variants | where: 'id', block.settings.variant | first %}
        {% endif %}
        total += {{ variant.inventory_quantity | default: 0 }};
      {% endif %}
    {% endfor %}
    return total;
  }
  
  function updateInventoryDisplay() {
    const inventory = getTotalInventory();
    const stockDot = document.getElementById('s703StockDot');
    const stockText = document.getElementById('s703StockText');
    
    if (!stockDot || !stockText) return;
    
    let text = config.stockHighText;
    let color = config.stockHighColor;
    
    if (inventory === 0) {
      text = config.stockOutText;
      color = config.stockOutColor;
    } else if (inventory <= config.inventoryLow) {
      text = config.stockLowText;
      color = config.stockLowColor;
    } else if (inventory <= config.inventoryMedium) {
      text = config.stockMediumText;
      color = config.stockMediumColor;
    }
    
    stockDot.style.backgroundColor = color;
    stockText.textContent = text;
    stockText.style.color = color;
  }
  
  // ==================== DELIVERY CALCULATION ====================
  function calculateDeliveryDates() {
    const now = new Date();
    const pstTime = new Date(now.toLocaleString('en-US', { timeZone: config.timeZone }));
    
    const cutoffToday = new Date(pstTime);
    cutoffToday.setHours(config.cutoffHour, config.cutoffMinute, 0, 0);
    
    let shipDate = new Date(pstTime);
    if (pstTime >= cutoffToday) {
      shipDate.setDate(shipDate.getDate() + 1);
    }
    
    while (config.nonShippingDays.includes(shipDate.getDay())) {
      shipDate.setDate(shipDate.getDate() + 1);
    }
    
    const minArrival = new Date(shipDate);
    minArrival.setDate(minArrival.getDate() + config.minTransitDays);
    
    const maxArrival = new Date(shipDate);
    maxArrival.setDate(maxArrival.getDate() + config.maxTransitDays);
    
    const timeUntilCutoff = cutoffToday - pstTime;
    const hoursLeft = Math.floor(timeUntilCutoff / (1000 * 60 * 60));
    const minutesLeft = Math.floor((timeUntilCutoff % (1000 * 60 * 60)) / (1000 * 60));
    
    return {
      minArrival: minArrival,
      maxArrival: maxArrival,
      hoursLeft: Math.max(0, hoursLeft),
      minutesLeft: Math.max(0, minutesLeft),
      pastCutoff: pstTime >= cutoffToday
    };
  }
  
  function formatDate(date) {
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const month = months[date.getMonth()];
    const day = date.getDate();
    const suffix = day === 1 || day === 21 || day === 31 ? 'st' : 
                   day === 2 || day === 22 ? 'nd' : 
                   day === 3 || day === 23 ? 'rd' : 'th';
    return `${month} ${day}${suffix}`;
  }
  
  function updateDeliveryText() {
    const deliveryText = document.getElementById('s703DeliveryText');
    if (!deliveryText) return;
    
    const delivery = calculateDeliveryDates();
    const minDate = formatDate(delivery.minArrival);
    const maxDate = formatDate(delivery.maxArrival);
    
    if (delivery.pastCutoff || (delivery.hoursLeft === 0 && delivery.minutesLeft === 0)) {
      deliveryText.innerHTML = `Get it between <span class="s703-delivery-highlight">${minDate} - ${maxDate}</span>`;
    } else {
      deliveryText.innerHTML = `Get it between <span class="s703-delivery-highlight">${minDate} - ${maxDate}</span> if ordered within <span class="s703-delivery-countdown">${delivery.hoursLeft} hrs ${delivery.minutesLeft} mins</span>`;
    }
  }
  
  // Initialize
  updateInventoryDisplay();
  updateDeliveryText();
  setInterval(updateDeliveryText, 60000);
  
  // ==================== CAROUSEL ====================
  let currentSlide = 0;
  const carousel = document.getElementById('s703Carousel');
  const dots = document.querySelectorAll('.s703-dot');
  const totalSlides = dots.length;
  
  window.s703GoToSlide = function(index) {
    currentSlide = index;
    updateCarousel();
  };
  
  window.s703NextSlide = function() {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateCarousel();
  };
  
  window.s703PrevSlide = function() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateCarousel();
  };
  
  function updateCarousel() {
    if (carousel) {
      carousel.style.transform = `translateX(-${currentSlide * 100}%)`;

      dots.forEach((dot, index) => {
        if (index === currentSlide) {
          dot.classList.add('active');
          dot.setAttribute('aria-selected', 'true');
        } else {
          dot.classList.remove('active');
          dot.setAttribute('aria-selected', 'false');
        }
      });
    }
  }

  // ==================== TOUCH DRAG FUNCTIONALITY ====================
  if (carousel) {
    let touchStartX = 0;
    let touchEndX = 0;
    let isDragging = false;
    let startTransform = 0;

    const carouselWrapper = carousel.closest('.s703-carousel-wrapper');

    function handleTouchStart(e) {
      touchStartX = e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
      isDragging = true;
      startTransform = currentSlide * 100;
      carousel.style.transition = 'none';
    }

    function handleTouchMove(e) {
      if (!isDragging) return;

      touchEndX = e.type.includes('mouse') ? e.pageX : e.touches[0].clientX;
      const diff = touchStartX - touchEndX;
      const carouselWidth = carousel.offsetWidth;
      const percentageMoved = (diff / carouselWidth) * 100;

      // Calculate new position with boundaries
      let newTransform = startTransform + percentageMoved;
      const maxTransform = (totalSlides - 1) * 100;

      // Allow slight overscroll for better UX
      if (newTransform < -10) newTransform = -10;
      if (newTransform > maxTransform + 10) newTransform = maxTransform + 10;

      carousel.style.transform = `translateX(-${newTransform}%)`;
    }

    function handleTouchEnd(e) {
      if (!isDragging) return;
      isDragging = false;

      carousel.style.transition = 'transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)';

      const diff = touchStartX - touchEndX;
      const threshold = 50; // Minimum swipe distance in pixels

      if (Math.abs(diff) > threshold) {
        if (diff > 0) {
          // Swiped left - go to next slide
          window.s703NextSlide();
        } else {
          // Swiped right - go to previous slide
          window.s703PrevSlide();
        }
      } else {
        // Snap back to current slide
        updateCarousel();
      }
    }

    // Add touch event listeners
    carouselWrapper.addEventListener('touchstart', handleTouchStart, { passive: true });
    carouselWrapper.addEventListener('touchmove', handleTouchMove, { passive: true });
    carouselWrapper.addEventListener('touchend', handleTouchEnd, { passive: true });

    // Add mouse event listeners for desktop testing
    carouselWrapper.addEventListener('mousedown', handleTouchStart);
    carouselWrapper.addEventListener('mousemove', handleTouchMove);
    carouselWrapper.addEventListener('mouseup', handleTouchEnd);
    carouselWrapper.addEventListener('mouseleave', handleTouchEnd);
  }
  
  // Remove skeleton on image load
  {% if section.settings.skeleton_enabled %}
    const carouselWrapper = document.querySelector('.s703-carousel-wrapper');
    const skeleton = document.querySelector('.s703-skeleton-carousel');
    const firstImage = document.querySelector('.s703-carousel-slide img');
    
    if (firstImage && skeleton && carouselWrapper) {
      firstImage.addEventListener('load', function() {
        skeleton.style.display = 'none';
        carouselWrapper.style.display = 'block';
      });
      
      if (firstImage.complete) {
        skeleton.style.display = 'none';
        carouselWrapper.style.display = 'block';
      }
    }
  {% endif %}
  
  // ==================== PURCHASE OPTION SELECTION ====================
  let selectedOption = 'autoship'; // 'autoship' or 'onetime'
  let packQuantity = config.cansPerCase;
  
  window.s703SelectOption = function(option) {
    selectedOption = option;
    const autoshipOption = document.getElementById('s703AutoshipOption');
    const onetimeOption = document.getElementById('s703OnetimeOption');
    
    if (option === 'autoship') {
      if (autoshipOption) autoshipOption.classList.add('selected');
      if (onetimeOption) onetimeOption.classList.remove('selected');
    } else {
      if (autoshipOption) autoshipOption.classList.remove('selected');
      if (onetimeOption) onetimeOption.classList.add('selected');
    }
    
    updatePricing();
  };
  
  // Initialize radio button state on page load
  document.addEventListener('DOMContentLoaded', function() {
    const autoshipOption = document.getElementById('s703AutoshipOption');
    if (autoshipOption) {
      autoshipOption.classList.add('selected');
    }
    // Initialize pack counts
    updatePackDisplay();
  });
  
  // Quantity controls
  window.s703IncreaseQty = function() {
    packQuantity += config.cansPerCase;
    updatePackDisplay();
    updatePricing();
  };
  
  window.s703DecreaseQty = function() {
    if (packQuantity > config.cansPerCase) {
      packQuantity -= config.cansPerCase;
      updatePackDisplay();
      updatePricing();
    }
  };
  
  function updatePackDisplay() {
    const packNumber = document.getElementById('s703PackNumber');
    if (packNumber) {
      packNumber.textContent = packQuantity;
    }
    
    // Update pack counts in option wrappers
    const autoshipPackCount = document.getElementById('s703AutoshipPackCount');
    const onetimePackCount = document.getElementById('s703OnetimePackCount');
    
    if (autoshipPackCount) {
      autoshipPackCount.textContent = packQuantity + ' PACK';
    }
    if (onetimePackCount) {
      onetimePackCount.textContent = packQuantity + ' PACK';
    }
  }
  
  // ==================== FLAVOR SELECTION ====================
  // Seeded from the first flavor block. With no blocks configured these stay
  // empty and both add-to-cart paths fall back to the section's own products,
  // exactly as before the selector existed.
  {% assign fb = section.blocks | where: 'type', 'flavor' %}
  {% assign ff = fb | first %}
  var s703Flavor = {
    trial:    '{{ ff.settings.trial_variant_id }}',
    autoship: '{{ ff.settings.autoship_variant_id }}',
    onetime:  '{{ ff.settings.onetime_variant_id }}'
  };

  function s703SetupFlavor(role) {
    var wrap = document.getElementById('s703-flavor-wrap-' + role);
    if (!wrap) return;
    var trigger  = document.getElementById('s703-flavor-trigger-' + role);
    var dropdown = document.getElementById('s703-flavor-dropdown-' + role);
    if (!trigger || !dropdown) return;
    var chevron = document.getElementById('s703-flavor-chevron-' + role);
    var isOpen = false;

    function close() {
      isOpen = false;
      dropdown.style.display = 'none';
      dropdown.setAttribute('aria-hidden', 'true');
      if (chevron) chevron.textContent = 'More \u25BE';
    }
    function open() {
      isOpen = true;
      dropdown.style.display = 'block';
      dropdown.setAttribute('aria-hidden', 'false');
      if (chevron) chevron.textContent = 'Less \u25B4';
    }
    close();

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      isOpen ? close() : open();
    });

    dropdown.querySelectorAll('.s703-flavor-option').forEach(function (option) {
      option.addEventListener('click', function (e) {
        e.stopPropagation();
        s703ApplyFlavor({
          trial:    option.getAttribute('data-trial-id'),
          autoship: option.getAttribute('data-autoship-id'),
          onetime:  option.getAttribute('data-onetime-id'),
          color:    option.getAttribute('data-swatch-color'),
          image:    option.getAttribute('data-swatch-image'),
          name:     option.getAttribute('data-name'),
          desc:     option.getAttribute('data-desc')
        });
        close();
      });
    });

    document.addEventListener('click', function (e) {
      if (!wrap.contains(e.target)) close();
    });
  }

  // Both pickers show the same flavour, so a choice in either updates both.
  function s703ApplyFlavor(f) {
    if (f.trial)    s703Flavor.trial = f.trial;
    if (f.autoship) s703Flavor.autoship = f.autoship;
    if (f.onetime)  s703Flavor.onetime = f.onetime;

    document.querySelectorAll('.s703-panel-flavor').forEach(function (el) {
      el.classList.toggle('is-active', el.getAttribute('data-panel-flavor') === f.name);
    });

    ['trial', 'autoship', 'onetime', 'ingredients', 'nutrition'].forEach(function (role) {
      var swatch = document.getElementById('s703-flavor-swatch-' + role);
      var nameEl = document.getElementById('s703-flavor-name-' + role);
      var descEl = document.getElementById('s703-flavor-desc-' + role);
      if (swatch) {
        swatch.style.backgroundColor = f.color || '';
        swatch.style.backgroundImage = f.image ? 'url(' + f.image + ')' : '';
      }
      if (nameEl) nameEl.textContent = f.name;
      if (descEl) descEl.textContent = f.desc;

      var dd = document.getElementById('s703-flavor-dropdown-' + role);
      if (!dd) return;
      dd.querySelectorAll('.s703-flavor-option').forEach(function (o) {
        o.classList.toggle('is-active', o.getAttribute('data-name') === f.name);
      });
    });
  }

  s703SetupFlavor('trial');
  s703SetupFlavor('autoship');
  s703SetupFlavor('onetime');
  s703SetupFlavor('ingredients');
  s703SetupFlavor('nutrition');


  // ==================== AFTER ADD TO CART ====================
  // 'drawer' keeps people on the page, which is the point of a hero buy box.
  // Falls back to the cart page when the theme is not running a drawer, so the
  // click always lands somewhere rather than appearing to do nothing.
  function s703AfterAdd() {
    var mode = '{{ section.settings.after_add | default: 'drawer' }}';
    if (mode === 'checkout') { window.location.href = '/checkout'; return; }
    if (mode === 'cart') { window.location.href = '/cart'; return; }

    var drawer = document.querySelector('cart-drawer');
    if (!drawer || typeof drawer.renderContents !== 'function') {
      window.location.href = '/cart';
      return;
    }
    fetch('/?sections=cart-drawer,cart-icon-bubble')
      .then(function (r) { return r.json(); })
      .then(function (sections) {
        drawer.classList.remove('is-empty');
        drawer.renderContents({ sections: sections });
      })
      .catch(function () { window.location.href = '/cart'; });
  }

  // Trial add to cart function
  window.s703AddTrialToCart = function() {
    const trialProductId = '{{ section.settings.trial_product.id | default: "" }}';
    const trialVariantId = '{{ section.settings.trial_variant_id | default: "" }}';
    const trialSellingPlanId = '{{ section.settings.trial_selling_plan_id | default: "" }}';
    
    if (!trialProductId) {
      console.error('Trial product not configured');
      return;
    }
    
    // Get first available variant if not specified
    let variantId = s703Flavor.trial || trialVariantId;
    if (!variantId) {
      {% if section.settings.trial_product %}
        variantId = '{{ section.settings.trial_product.selected_or_first_available_variant.id }}';
      {% endif %}
    }
    
    const formData = {
      'items': [{
        'id': parseInt(variantId),
        'quantity': 1
      }]
    };
    
    // Add selling plan if configured
    if (trialSellingPlanId) {
      formData.items[0].selling_plan = parseInt(trialSellingPlanId);
    }
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(formData)
    })
    .then(response => response.json())
    .then(data => {
      console.log('Trial added to cart:', data);
      s703AfterAdd();
    })
    .catch(error => {
      console.error('Error adding trial to cart:', error);
    });
  };
  
  // Legacy compatibility - keep old function names working
  window.s703SelectSubscription = function() {
    s703SelectOption('autoship');
  };
  
  window.s703SelectOnetime = function() {
    s703SelectOption('onetime');
  };
  
  // ==================== FLAVOR SELECTION ====================
  const flavorQuantities = {};
  
  window.s703AddFlavor = function(index) {
    if (!flavorQuantities[index]) {
      flavorQuantities[index] = config.cansPerCase;
    }
    
    const addBtn = document.querySelector(`.s703-flavor-add-btn[data-flavor-index="${index}"]`);
    const qtyDiv = document.querySelector(`.s703-flavor-quantity[data-flavor-index="${index}"]`);
    
    if (addBtn && qtyDiv) {
      addBtn.classList.add('hidden');
      setTimeout(() => {
        qtyDiv.classList.add('active');
        updateFlavorDisplay(index);
        updatePricing();
      }, 100);
    }
  };
  
  window.s703IncreaseFlavor = function(index) {
    if (!flavorQuantities[index]) {
      flavorQuantities[index] = config.cansPerCase;
    } else {
      flavorQuantities[index] += config.cansPerCase;
    }
    updateFlavorDisplay(index);
    updatePricing();
  };
  
  window.s703DecreaseFlavor = function(index) {
    if (flavorQuantities[index] && flavorQuantities[index] > config.cansPerCase) {
      flavorQuantities[index] -= config.cansPerCase;
      updateFlavorDisplay(index);
      updatePricing();
    } else {
      delete flavorQuantities[index];
      const addBtn = document.querySelector(`.s703-flavor-add-btn[data-flavor-index="${index}"]`);
      const qtyDiv = document.querySelector(`.s703-flavor-quantity[data-flavor-index="${index}"]`);
      
      if (addBtn && qtyDiv) {
        qtyDiv.classList.remove('active');
        setTimeout(() => {
          addBtn.classList.remove('hidden');
          updatePricing();
        }, 100);
      }
    }
  };
  
  function updateFlavorDisplay(index) {
    const qtyDisplay = document.querySelector(`.s703-flavor-quantity[data-flavor-index="${index}"] .s703-qty-display`);
    const packText = document.querySelector(`.s703-flavor-item[data-flavor-index="${index}"] .s703-flavor-pack`);
    
    if (flavorQuantities[index]) {
      const cans = flavorQuantities[index];
      
      if (qtyDisplay) {
        qtyDisplay.innerHTML = cans + '<br>PACK';
      }
      
      if (packText) {
        packText.textContent = cans + ' Pack';
      }
    }
  }
  
  function updatePricing() {
    // Calculate prices based on pack quantity
    const autoshipPricePerCan = parseFloat('{{ section.settings.autoship_price_per_can | default: "3.99" }}');
    const onetimePricePerCan = parseFloat('{{ section.settings.onetime_price_per_can | default: "5.00" }}');
    
    const autoshipTotal = packQuantity * autoshipPricePerCan;
    const onetimeTotal = packQuantity * onetimePricePerCan;
    
    // Update autoship price display
    const autoshipPrice = document.getElementById('s703AutoshipPrice');
    if (autoshipPrice) {
      autoshipPrice.textContent = '$' + autoshipTotal.toFixed(2);
    }
    
    // Update onetime price display
    const onetimePrice = document.getElementById('s703OnetimePrice');
    if (onetimePrice) {
      onetimePrice.textContent = '$' + onetimeTotal.toFixed(2);
    }
  }
  
  updatePricing();
  
  // ==================== ADD TO CART ====================
  window.s703AddToCart = function() {
    const items = [];
    let variantId;
    let sellingPlanId;
    
    // Determine which product to use based on selected option
    if (selectedOption === 'autoship') {
      {% if section.settings.autoship_product %}
        variantId = '{{ section.settings.autoship_product.selected_or_first_available_variant.id }}';
      {% endif %}
      if (s703Flavor.autoship) variantId = s703Flavor.autoship;
      sellingPlanId = '{{ section.settings.loop_selling_plan_id | strip }}';
    } else {
      {% if section.settings.onetime_product %}
        variantId = '{{ section.settings.onetime_product.selected_or_first_available_variant.id }}';
      {% endif %}
      if (s703Flavor.onetime) variantId = s703Flavor.onetime;
    }
    
    if (!variantId) {
      console.error('Product not configured');
      alert('Product not configured. Please contact support.');
      return;
    }
    
    const itemData = {
      id: parseInt(variantId),
      quantity: Math.max(1, Math.round(packQuantity / config.cansPerCase)) // Convert cans to packs, minimum 1
    };
    
    // Add selling plan for autoship only if valid
    if (selectedOption === 'autoship' && sellingPlanId && sellingPlanId.trim() !== '' && !isNaN(parseInt(sellingPlanId))) {
      itemData.selling_plan = parseInt(sellingPlanId);
    }
    
    console.log('Adding to cart:', itemData);
    items.push(itemData);
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ items: items })
    })
    .then(response => {
      if (!response.ok) {
        return response.json().then(err => { throw new Error(err.description || 'Failed to add to cart'); });
      }
      return response.json();
    })
    .then(data => {
      console.log('Added to cart:', data);
      
      // Check if there was an error in the response
      if (data.status === 422 || data.description) {
        throw new Error(data.description || 'Error adding to cart');
      }
      
      const note = selectedOption === 'autoship' 
        ? `Subscription Order: ${packQuantity} cans`
        : `One-Time Order: ${packQuantity} cans`;
      
      return fetch('/cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ note: note })
      });
    })
    .then(response => response.json())
    .then(data => {
      s703AfterAdd();
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      alert('Error: ' + error.message);
    });
  };
  
  // ==================== PANELS ====================
  window.s703OpenPanel = function(type) {
    let panel;
    
    if (type === 'ingredients') {
      panel = document.getElementById('s703IngredientsPanel');
    } else if (type === 'nutrition') {
      panel = document.getElementById('s703NutritionPanel');
    }
    
    if (panel) {
      if (typeof panel.showModal === 'function') {
        panel.showModal();
      } else {
        panel.setAttribute('open', '');
      }
    }
  };
  
  document.querySelectorAll('.s703-panel').forEach(function (dlg) {
    // The dialog itself is the event target only when the press landed on the
    // backdrop rather than inside .s703-panel-inner.
    dlg.addEventListener('click', function (e) { if (e.target === dlg) s703ClosePanel(); });
  });

  window.s703ClosePanel = function() {
    document.querySelectorAll('.s703-panel').forEach(panel => {
      if (panel.close) { panel.close(); } else { panel.removeAttribute('open'); }
    });
  };
  
  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      s703ClosePanel();
    }
  });
  
  const subToggle = document.getElementById('s703SubToggle');
  if (subToggle) {
    subToggle.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        s703SelectSubscription();
      }
    });
  }
  
  const onetimeToggle = document.getElementById('s703OnetimeToggle');
  if (onetimeToggle) {
    onetimeToggle.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        s703SelectOnetime();
      }
    });
  }
  
  // ==================== ACCORDION ====================
  window.s703ToggleAccordion = function(button) {
    const content = button.nextElementSibling;
    const isActive = button.classList.contains('active');
    
    if (isActive) {
      button.classList.remove('active');
      button.setAttribute('aria-expanded', 'false');
      content.classList.remove('active');
    } else {
      button.classList.add('active');
      button.setAttribute('aria-expanded', 'true');
      content.classList.add('active');
    }
  };
  
})();
</script>
