{% liquid
  assign current_year = 'now' | date: '%Y'
  assign accent_color = section.settings.accent_color | default: '#C6F952'
  assign text_color = section.settings.text_color | default: '#000000'
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign border_color = section.settings.border_color | default: '#E2E2E2'
  assign input_border = section.settings.input_border_color | default: '#E2E2E2'
  assign placeholder_color = section.settings.placeholder_color | default: '#A9A9A9'
%}

<style>
  .section-712-footer {
    --s712-accent: {{ accent_color }};
    --s712-text: {{ text_color }};
    --s712-bg: {{ bg_color }};
    --s712-border: {{ border_color }};
    --s712-input-border: {{ input_border }};
    --s712-placeholder: {{ placeholder_color }};
    
    background-color: var(--s712-bg);
    color: var(--s712-text);
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }

  .section-712-footer__container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  /* Desktop Layout */
  .section-712-footer__desktop {
    display: none;
  }

  .section-712-footer__columns {
    display: grid;
    grid-template-columns: 1fr 1fr 1.8fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 25px;
  }

  .section-712-footer__column {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .section-712-footer__column-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 7px 0;
  }

  .section-712-footer__link {
    color: var(--s712-text);
    text-decoration: none;
    font-size: 16px;
    line-height: 1.5;
    transition: opacity 0.2s ease;
  }

  .section-712-footer__link:hover {
    opacity: 0.7;
  }

  .section-712-footer__link:focus-visible {
    outline: 2px solid var(--s712-accent);
    outline-offset: 2px;
  }

  /* Newsletter Section */
  .section-712-footer__newsletter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .section-712-footer__logo {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  .section-712-footer__benefits {
    display: flex;
    gap: 23px;
    margin-bottom: 3px;
    flex-wrap: nowrap;
    justify-content: center;
  }

  .section-712-footer__benefit {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    white-space: nowrap;
  }

  .section-712-footer__checkmark {
    width: 16px;
    height: 16px;
    background-color: var(--s712-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-712-footer__checkmark svg {
    width: 8px;
    height: 7px;
    stroke: var(--s712-text);
    stroke-width: 1.5;
    fill: none;
  }

  .section-712-footer__form-wrapper {
    background-color: var(--s712-text);
    border-radius: 15px;
    padding: 6px;
    width: 100%;
    max-width: 100%;
  }

  .section-712-footer__form {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .section-712-footer__input {
    background-color: var(--s712-bg);
    border: 1px solid var(--s712-input-border);
    border-radius: 10px;
    padding: 18px 20px;
    font-size: 14px;
    color: var(--s712-text);
    width: 100%;
  }

  .section-712-footer__input::placeholder {
    color: var(--s712-placeholder);
  }

  .section-712-footer__input:focus {
    outline: 2px solid var(--s712-accent);
    outline-offset: -1px;
  }

  .section-712-footer__submit {
    background-color: var(--s712-accent);
    border: 1px solid var(--s712-text);
    border-radius: 10px;
    padding: 18px;
    font-size: 14px;
    font-weight: 700;
    color: var(--s712-text);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: opacity 0.2s ease;
  }

  .section-712-footer__submit:hover {
    opacity: 0.9;
  }

  .section-712-footer__submit:focus-visible {
    outline: 2px solid var(--s712-text);
    outline-offset: 2px;
  }

  .section-712-footer__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Social Icons */
  .section-712-footer__social {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 10px;
  }

  .section-712-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--s712-text);
    transition: opacity 0.2s ease;
  }

  .section-712-footer__social-link:hover {
    opacity: 0.7;
  }

  .section-712-footer__social-link:focus-visible {
    outline: 2px solid var(--s712-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .section-712-footer__social-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Copyright */
  .section-712-footer__copyright {
    text-align: center;
    font-size: 10px;
    line-height: 1;
  }

  /* Mobile Layout */
  .section-712-footer__mobile {
    display: block;
  }

  .section-712-footer__accordion {
    border-bottom: 1px solid var(--s712-border);
  }

  .section-712-footer__accordion-button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 17px 20px;
    background: none;
    border: none;
    border-top: 1px solid var(--s712-border);
    font-size: 16px;
    font-weight: 600;
    color: var(--s712-text);
    cursor: pointer;
    text-align: left;
  }

  .section-712-footer__accordion-button:focus-visible {
    outline: 2px solid var(--s712-accent);
    outline-offset: -2px;
  }

  .section-712-footer__accordion-icon {
    width: 40px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .section-712-footer__accordion-icon svg {
    width: 20px;
    height: 10px;
    stroke: var(--s712-text);
    stroke-width: 1.5;
    fill: none;
  }

  .section-712-footer__accordion.is-open .section-712-footer__accordion-icon {
    transform: rotate(180deg);
  }

  .section-712-footer__accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .section-712-footer__accordion.is-open .section-712-footer__accordion-content {
    max-height: 500px;
  }

  .section-712-footer__accordion-links {
    padding: 0 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Skeleton Loader */
  {% if section.settings.skeleton_enabled %}
  .section-712-footer__skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: s712-pulse 1.5s ease-in-out infinite;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-712-footer__skeleton {
      animation: none;
    }
  }

  @keyframes s712-pulse {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .section-712-footer__skeleton--logo {
    width: 80px;
    height: 29px;
    margin: 0 auto 8px;
  }

  .section-712-footer__skeleton--form {
    width: 100%;
    height: 110px;
    border-radius: 15px;
  }

  .section-712-footer__skeleton--text {
    height: 16px;
    margin-bottom: 8px;
  }

  .section-712-footer [data-loaded="true"] .section-712-footer__skeleton {
    display: none;
  }
  {% endif %}

  /* Responsive Breakpoints */
  @media (min-width: 768px) {
    .section-712-footer__mobile {
      display: none;
    }

    .section-712-footer__desktop {
      display: block;
    }
  }

  @media (max-width: 1200px) {
    .section-712-footer__columns {
      grid-template-columns: 1fr 1fr 1.5fr 1fr 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 1024px) {
    .section-712-footer__columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }

    .section-712-footer__newsletter {
      grid-column: 1 / -1;
      max-width: 500px;
      margin: 0 auto;
    }
  }
</style>

<footer class="section-712-footer" role="contentinfo" aria-label="Site footer">
  <div class="section-712-footer__container">
    
    {%- comment -%} Desktop Layout {%- endcomment -%}
    <div class="section-712-footer__desktop">
      <div class="section-712-footer__columns">
        
        {%- comment -%} Column 1 {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'column' and forloop.index <= 2 -%}
              <nav class="section-712-footer__column" {{ block.shopify_attributes }}>
                <h2 class="section-712-footer__column-title">{{ block.settings.title }}</h2>
                {%- for i in (1..6) -%}
                  {%- assign link_text = 'link_' | append: i | append: '_text' -%}
                  {%- assign link_url = 'link_' | append: i | append: '_url' -%}
                  {%- if block.settings[link_text] != blank -%}
                    <a href="{{ block.settings[link_url] }}" class="section-712-footer__link">
                      {{ block.settings[link_text] }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </nav>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Newsletter Section {%- endcomment -%}
        <div class="section-712-footer__newsletter">
          {%- if section.settings.logo != blank -%}
            {% if section.settings.skeleton_enabled %}
              <div class="section-712-footer__skeleton section-712-footer__skeleton--logo" aria-hidden="true"></div>
            {% endif %}
            <img 
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ section.settings.logo.alt | default: shop.name }}"
              class="section-712-footer__logo"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="lazy"
              decoding="async"
              onload="this.parentElement.setAttribute('data-loaded', 'true')"
            >
          {%- endif -%}

          {%- if section.settings.show_benefits -%}
            <div class="section-712-footer__benefits">
              <div class="section-712-footer__benefit">
                <span class="section-712-footer__checkmark" aria-hidden="true">
                  <svg viewBox="0 0 8 7"><polyline points="1,3.5 3,5.5 7,1.5"></polyline></svg>
                </span>
                <span>{{ section.settings.benefit_1 }}</span>
              </div>
              <div class="section-712-footer__benefit">
                <span class="section-712-footer__checkmark" aria-hidden="true">
                  <svg viewBox="0 0 8 7"><polyline points="1,3.5 3,5.5 7,1.5"></polyline></svg>
                </span>
                <span>{{ section.settings.benefit_2 }}</span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_newsletter -%}
            {% if section.settings.skeleton_enabled %}
              <div class="section-712-footer__skeleton section-712-footer__skeleton--form" aria-hidden="true"></div>
            {% endif %}
            <div class="section-712-footer__form-wrapper" data-loaded="true">
              <form 
                class="section-712-footer__form s712-klaviyo-form"
                data-list-id="{{ section.settings.klaviyo_list_id }}"
                aria-label="Newsletter signup"
              >
                <input 
                  type="email" 
                  name="email" 
                  class="section-712-footer__input"
                  placeholder="{{ section.settings.input_placeholder }}"
                  required
                  aria-label="Email address"
                >
                <button 
                  type="submit" 
                  class="section-712-footer__submit"
                >
                  {{ section.settings.submit_text }}
                </button>
              </form>
            </div>
          {%- endif -%}

          {%- if section.settings.show_social -%}
            <div class="section-712-footer__social">
              {%- if section.settings.social_facebook != blank -%}
                <a href="{{ section.settings.social_facebook }}" class="section-712-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.social_instagram != blank -%}
                <a href="{{ section.settings.social_instagram }}" class="section-712-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.social_twitter != blank -%}
                <a href="{{ section.settings.social_twitter }}" class="section-712-footer__social-link" aria-label="Twitter" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.social_tiktok != blank -%}
                <a href="{{ section.settings.social_tiktok }}" class="section-712-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Columns 4 & 5 {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'column' and forloop.index > 2 -%}
              <nav class="section-712-footer__column" {{ block.shopify_attributes }}>
                <h2 class="section-712-footer__column-title">{{ block.settings.title }}</h2>
                {%- for i in (1..6) -%}
                  {%- assign link_text = 'link_' | append: i | append: '_text' -%}
                  {%- assign link_url = 'link_' | append: i | append: '_url' -%}
                  {%- if block.settings[link_text] != blank -%}
                    <a href="{{ block.settings[link_url] }}" class="section-712-footer__link">
                      {{ block.settings[link_text] }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </nav>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

      </div>

      <p class="section-712-footer__copyright">
        {{ section.settings.copyright_text | replace: '[year]', current_year }}
      </p>
    </div>

    {%- comment -%} Mobile Layout {%- endcomment -%}
    <div class="section-712-footer__mobile">
      
      {%- comment -%} Newsletter Section {%- endcomment -%}
      <div class="section-712-footer__newsletter">
        {%- if section.settings.logo != blank -%}
          {% if section.settings.skeleton_enabled %}
            <div class="section-712-footer__skeleton section-712-footer__skeleton--logo" aria-hidden="true"></div>
          {% endif %}
          <img 
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            class="section-712-footer__logo"
            width="{{ section.settings.logo_width }}"
            height="auto"
            loading="lazy"
            decoding="async"
            onload="this.parentElement.setAttribute('data-loaded', 'true')"
          >
        {%- endif -%}

        {%- if section.settings.show_benefits -%}
          <div class="section-712-footer__benefits">
            <div class="section-712-footer__benefit">
              <span class="section-712-footer__checkmark" aria-hidden="true">
                <svg viewBox="0 0 8 7"><polyline points="1,3.5 3,5.5 7,1.5"></polyline></svg>
              </span>
              <span>{{ section.settings.benefit_1 }}</span>
            </div>
            <div class="section-712-footer__benefit">
              <span class="section-712-footer__checkmark" aria-hidden="true">
                <svg viewBox="0 0 8 7"><polyline points="1,3.5 3,5.5 7,1.5"></polyline></svg>
              </span>
              <span>{{ section.settings.benefit_2 }}</span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {% if section.settings.skeleton_enabled %}
            <div class="section-712-footer__skeleton section-712-footer__skeleton--form" aria-hidden="true"></div>
          {% endif %}
          <div class="section-712-footer__form-wrapper" data-loaded="true">
            <form 
              class="section-712-footer__form s712-klaviyo-form"
              data-list-id="{{ section.settings.klaviyo_list_id }}"
              aria-label="Newsletter signup"
            >
              <input 
                type="email" 
                name="email" 
                class="section-712-footer__input"
                placeholder="{{ section.settings.input_placeholder }}"
                required
                aria-label="Email address"
              >
              <button 
                type="submit" 
                class="section-712-footer__submit"
              >
                {{ section.settings.submit_text }}
              </button>
            </form>
          </div>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="section-712-footer__social">
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" class="section-712-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" class="section-712-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
