            <div 
              class="section-712-footer__accordion-content"
              id="s712-accordion-{{ block.id }}"
            >
              <nav class="section-712-footer__accordion-links">
                {%- for i in (1..6) -%}
                  {%- assign link_text = 'link_' | append: i | append: '_text' -%}
                  {%- assign link_url = 'link_' | append: i | append: '_url' -%}
                  {%- if block.settings[link_text] != blank -%}
                    <a href="{{ block.settings[link_url] }}" class="section-712-footer__link">
                      {{ block.settings[link_text] }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </nav>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <p class="section-712-footer__copyright" style="margin-top: 33px;">
        {{ section.settings.copyright_text | replace: '[year]', current_year }}
      </p>
    </div>

  </div>
</footer>

<script>
(function() {
  // Mobile Accordion
  const accordions = document.querySelectorAll('.section-712-footer__accordion-button');
  
  accordions.forEach(button => {
    button.addEventListener('click', function() {
      const accordion = this.parentElement;
      const isOpen = accordion.classList.contains('is-open');
      
      // Close all accordions (accordion behavior)
      document.querySelectorAll('.section-712-footer__accordion').forEach(acc => {
        acc.classList.remove('is-open');
        acc.querySelector('.section-712-footer__accordion-button').setAttribute('aria-expanded', 'false');
      });
      
      // Open clicked accordion if it was closed
      if (!isOpen) {
        accordion.classList.add('is-open');
        this.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Klaviyo Integration - Using the proven method from section 203
  const forms = document.querySelectorAll('.s712-klaviyo-form');
  
  forms.forEach(form => {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const email = this.querySelector('input[type="email"]').value;
      const listId = this.getAttribute('data-list-id');
      const submitBtn = this.querySelector('button[type="submit"]');
      
      if (!listId) {
        console.error('Klaviyo List ID not configured');
        alert('Newsletter signup is not properly configured. Please add your Klaviyo List ID in the theme settings.');
        return;
      }
      
      // Disable button
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'SUBSCRIBING...';
      
      try {
        // Method 1: Check if Klaviyo's tracking script is loaded
        if (typeof _learnq !== 'undefined') {
          // Identify the user
          _learnq.push(['identify', {
            '$email': email
          }]);
          
          // Track a custom event
          _learnq.push(['track', 'Newsletter Signup', {
            'List': listId,
            'Source': 'Footer Form',
            '$email': email
          }]);
          
          console.log('Submitted to Klaviyo via _learnq');
        }
        
        // Method 2: Submit via AJAX to Klaviyo's form endpoint as backup
        const formData = new FormData();
        formData.append('g', listId);
        formData.append('email', email);
        
        await fetch(`https://manage.kmail-lists.com/ajax/subscriptions/subscribe`, {
          method: 'POST',
          body: formData,
          mode: 'no-cors'
        });
        
        console.log('Also submitted via form endpoint');
        
        // Success!
        submitBtn.textContent = '✓ SUBSCRIBED!';
        this.querySelector('input[type="email"]').value = '';
        
        setTimeout(() => {
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }, 3000);
        
      } catch (error) {
        console.error('Klaviyo subscription error:', error);
        alert('There was an error subscribing. Please try again.');
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
})();
</script>

