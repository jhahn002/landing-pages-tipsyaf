      {%- comment -%} Accordions {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="section-712-footer__accordion" {{ block.shopify_attributes }}>
            <button 
              class="section-712-footer__accordion-button"
              aria-expanded="false"
              aria-controls="s712-accordion-{{ block.id }}"
            >
              <span>{{ block.settings.title }}</span>
              <span class="section-712-footer__accordion-icon" aria-hidden="true">
