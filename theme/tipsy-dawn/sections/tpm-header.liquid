{%- comment -%}
  TIPSY floating header: a white rounded bar inset from the screen edges, sticky
  while scrolling. On the home page it floats over the hero; elsewhere it reserves
  its own height. The cart link keeps id="cart-icon-bubble" so Dawn's cart drawer
  opens from it and refreshes its count.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign overlay = false
  if template.name == 'index' and s.overlay_home
    assign overlay = true
  endif
-%}
<style>
  .tpm-hdr-section { position: sticky; top: 0; z-index: 40; }
  .tpm-hdr { position: relative; height: 78px; font-family: var(--font-figtree), system-ui, sans-serif; color: #1f1e21; }
  .tpm-hdr--overlay { height: 0; }
  .tpm-hdr__bar { position: absolute; z-index: 3; left: 12px; right: 12px; top: 12px; height: 54px; max-width: 1240px; margin: 0 auto; border-radius: 18px; background: #fff; box-shadow: 0 6px 20px rgba(0,0,0,.12); display: flex; align-items: center; justify-content: space-between; padding: 0 4px; transition: box-shadow .3s ease; }
  .tpm-hdr.is-scrolled .tpm-hdr__bar { box-shadow: 0 8px 28px rgba(0,0,0,.16); }
  .tpm-hdr__icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 0; background: none; padding: 0; color: inherit; cursor: pointer; position: relative; }
  .tpm-hdr__icon:focus-visible, .tpm-hdr a:focus-visible { outline: 2px solid #1f1e21; outline-offset: 2px; border-radius: 10px; }
  .tpm-hdr__burger span { position: absolute; left: 12px; height: 2px; border-radius: 2px; background: currentColor; transition: transform .3s ease, width .3s ease, opacity .2s ease; transform-origin: left center; }
  .tpm-hdr__burger span:nth-child(1) { top: 15px; width: 20px; }
  .tpm-hdr__burger span:nth-child(2) { top: 21px; width: 14px; }
  .tpm-hdr__burger span:nth-child(3) { top: 27px; width: 9px; }
  .tpm-hdr.is-open .tpm-hdr__burger span:nth-child(1) { width: 22px; transform: translate(3px,-1px) rotate(45deg); }
  .tpm-hdr.is-open .tpm-hdr__burger span:nth-child(2) { opacity: 0; }
  .tpm-hdr.is-open .tpm-hdr__burger span:nth-child(3) { width: 22px; transform: translate(3px,1px) rotate(-45deg); }
  .tpm-hdr__logo { position: absolute; left: 50%; transform: translateX(-50%); display: flex; align-items: center; color: inherit; text-decoration: none; font-weight: 800; font-size: 21px; letter-spacing: .02em; line-height: 1; }
  .tpm-hdr__logo span { font-weight: 400; }
  .tpm-hdr__logo img { display: block; height: 22px; width: auto; }
  .tpm-hdr__cart .svg-wrapper { display: flex; width: 40px; height: 40px; }
  .tpm-hdr__cart svg { width: 40px; height: 40px; }
  .tpm-hdr__cart .cart-count-bubble { position: absolute; top: 5px; right: 4px; min-width: 17px; height: 17px; padding: 0 3px; border-radius: 999px; background: #ffe748; color: #1f1e21; border: 1.5px solid #fff; font-size: 10px; font-weight: 800; line-height: 1; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
  .tpm-hdr__desk { display: none; }
  .tpm-hdr__scrim { position: fixed; inset: 0; z-index: 1; background: rgba(20,12,8,.45); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; visibility: hidden; transition: opacity .3s ease, visibility 0s linear .3s; }
  .tpm-hdr.is-open .tpm-hdr__scrim { opacity: 1; visibility: visible; transition: opacity .3s ease; }
  .tpm-hdr__menu { position: absolute; z-index: 2; left: 12px; right: 12px; top: 74px; max-width: 520px; max-height: calc(100svh - 90px); overflow: auto; box-sizing: border-box; border-radius: 22px; background: #fff; padding: 14px; display: grid; gap: 12px; box-shadow: 0 18px 40px rgba(0,0,0,.18); opacity: 0; visibility: hidden; transform: translateY(-10px) scale(.97); transform-origin: top center; transition: opacity .3s ease, transform .35s cubic-bezier(.2,.8,.2,1), visibility 0s linear .35s; }
  .tpm-hdr.is-open .tpm-hdr__menu { opacity: 1; visibility: visible; transform: none; transition: opacity .3s ease, transform .35s cubic-bezier(.2,.8,.2,1); }
  .tpm-hdr__tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .tpm-hdr__tile { position: relative; height: 168px; border-radius: 16px; overflow: hidden; color: #1f1e21; text-decoration: none; }
  .tpm-hdr__tile img { position: absolute; left: 50%; top: 12px; height: 104px; width: auto; transform: translateX(-50%) rotate(-6deg); transition: transform .35s ease; }
  .tpm-hdr__tile:nth-child(2) img { transform: translateX(-50%) rotate(6deg); }
  .tpm-hdr__tile:hover img { transform: translateX(-50%) rotate(0deg) translateY(-4px); }
  .tpm-hdr__tile span { position: absolute; left: 12px; right: 12px; bottom: 10px; font-size: 14px; font-weight: 700; line-height: 1.15; }
  .tpm-hdr__big { display: grid; }
  .tpm-hdr__big a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 52px; border-bottom: 1px solid #efe9df; color: inherit; text-decoration: none; }
  .tpm-hdr__big a:last-child { border-bottom: 0; }
  .tpm-hdr__big b { font-family: var(--font-serif), Georgia, serif; font-weight: 400; font-size: 26px; }
  .tpm-hdr__big small { font-size: 14px; font-weight: 600; color: #5d5a62; }
  .tpm-hdr__small { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; padding: 10px 2px 0; border-top: 1px solid #efe9df; }
  .tpm-hdr__small a { min-height: 40px; display: flex; align-items: center; font-size: 15px; font-weight: 500; color: inherit; text-decoration: none; }
  @media (min-width: 990px) {
    .tpm-hdr { height: 92px; }
    .tpm-hdr--overlay { height: 0; }
    .tpm-hdr__bar { left: 28px; right: 28px; top: 16px; height: 60px; padding: 0 10px 0 6px; }
    .tpm-hdr__desk { display: flex; gap: 4px; margin-right: auto; margin-left: 4px; }
    .tpm-hdr__desk a { min-height: 44px; display: flex; align-items: center; padding: 0 12px; border-radius: 12px; font-size: 15px; font-weight: 600; color: inherit; text-decoration: none; }
    .tpm-hdr__desk a:hover { background: #f4efe7; }
    .tpm-hdr__menu { left: max(28px, calc((100% - 1240px) / 2)); right: auto; width: 440px; top: 84px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tpm-hdr__menu, .tpm-hdr__scrim, .tpm-hdr__burger span { transition: none; }
  }
</style>

<div class="tpm-hdr{% if overlay %} tpm-hdr--overlay{% endif %}" data-tpm-hdr>
  <div class="tpm-hdr__scrim" data-tpm-hdr-close></div>

  <div class="tpm-hdr__bar">
    <button type="button" class="tpm-hdr__icon tpm-hdr__burger" aria-expanded="false" aria-controls="TpmMenu-{{ section.id }}" aria-label="Open menu" data-tpm-hdr-toggle>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>

    {%- if section.blocks.size > 0 -%}
      <nav class="tpm-hdr__desk" aria-label="Shop">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <a href="{{ routes.root_url }}" class="tpm-hdr__logo" aria-label="{{ shop.name | escape }} home">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: height: 88 | image_tag: alt: shop.name, height: 22, loading: 'eager' }}
      {%- else -%}
        TIPSY<span>AF</span>
      {%- endif -%}
    </a>

    <a href="{{ routes.cart_url }}" class="tpm-hdr__icon tpm-hdr__cart" id="cart-icon-bubble">
      {% if cart == empty %}
        <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
      {% else %}
        <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
      {% endif %}
      <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
      {%- if cart != empty -%}
        <div class="cart-count-bubble">
          {%- if cart.item_count < 100 -%}
            <span aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </div>
      {%- endif -%}
    </a>
  </div>

  <nav class="tpm-hdr__menu" id="TpmMenu-{{ section.id }}" aria-label="Main" inert>
    <div class="tpm-hdr__tiles">
      {%- liquid
        assign p1 = s.flavor_1_product
        assign p2 = s.flavor_2_product
      -%}
      <a class="tpm-hdr__tile" href="{{ p1.url | default: routes.all_products_collection_url }}" style="background: linear-gradient(170deg, #ffe0c2, #ffb27d)">
        <img src="{{ 'tipsy-can-blood-orange.webp' | asset_url }}" alt="" loading="lazy" width="289" height="755">
        <span>{{ s.flavor_1_label | escape }}</span>
      </a>
      <a class="tpm-hdr__tile" href="{{ p2.url | default: routes.all_products_collection_url }}" style="background: linear-gradient(170deg, #fff1b0, #ffd23f)">
        <img src="{{ 'tipsy-can-pineapple.webp' | asset_url }}" alt="" loading="lazy" width="415" height="1086">
        <span>{{ s.flavor_2_label | escape }}</span>
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="tpm-hdr__big">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            <b>{{ block.settings.label | escape }}</b>
            {%- if block.settings.note != blank -%}<small>{{ block.settings.note | escape }}</small>{%- else -%}<span aria-hidden="true">→</span>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign small_menu = linklists[s.secondary_menu] -%}
    {%- if small_menu.links.size > 0 -%}
      <div class="tpm-hdr__small">
        {%- for link in small_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </nav>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-tpm-hdr]')) return;
    var btn = root.querySelector('[data-tpm-hdr-toggle]');
    var menu = root.querySelector('.tpm-hdr__menu');
    function set(open) {
      root.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) { menu.removeAttribute('inert'); } else { menu.setAttribute('inert', ''); }
    }
    btn.addEventListener('click', function () { set(!root.classList.contains('is-open')); });
    root.querySelectorAll('[data-tpm-hdr-close]').forEach(function (el) { el.addEventListener('click', function () { set(false); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('is-open')) { set(false); btn.focus(); } });
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return; ticking = true;
      requestAnimationFrame(function () { root.classList.toggle('is-scrolled', window.scrollY > 8); ticking = false; });
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "TIPSY header",
  "class": "tpm-hdr-section",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the TIPSY AF wordmark." },
    { "type": "checkbox", "id": "overlay_home", "label": "Float over the hero on the home page", "default": true },
    { "type": "header", "content": "Menu flavor tiles" },
    { "type": "product", "id": "flavor_1_product", "label": "First tile product" },
    { "type": "text", "id": "flavor_1_label", "label": "First tile label", "default": "Blood Orange Margarita" },
    { "type": "product", "id": "flavor_2_product", "label": "Second tile product" },
    { "type": "text", "id": "flavor_2_label", "label": "Second tile label", "default": "Pineapple Martini" },
    { "type": "link_list", "id": "secondary_menu", "label": "Small links", "default": "main-menu" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Shop link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "note", "label": "Note on the right", "info": "For example a price. Leave empty for an arrow." }
      ]
    }
  ]
}
{% endschema %}
