/* TIPSY AF advertorial. Editorial article layout, scoped to .tpa. */

.tpa {
  --ink: #1f1e21;
  --muted: #5f5e63;
  --paper: #ffffff;
  --panel: #f4f3f1;
  --line: #e6e4e0;
  --accent: #ffe748;
  --night: #131826;
  --error: #b42318;
  --sans: 'Figtree', 'TPM Sofia', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
  --cond: 'TPM Condensed', 'League Gothic', Impact, sans-serif;

  color: var(--ink);
  background: var(--paper);
  font-family: var(--sans);
  font-size: 18px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
.tpa *, .tpa *::before, .tpa *::after { box-sizing: border-box; }
.tpa img { display: block; max-width: 100%; height: auto; }
.tpa :where(h1, h2, p, ul, ol, figure, blockquote) { margin: 0; padding: 0; }
