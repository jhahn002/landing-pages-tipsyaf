/* Chart */
.tpa-chart { background: var(--night); border-radius: 16px; padding: 18px 14px 12px; }
.tpa-chart svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
.tpa-chart__base { stroke: rgba(255,255,255,.3); stroke-width: 1.5; }
