.tpa :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 6px; }

.tpa-adlabel { text-align: center; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); padding: 8px 16px; border-bottom: 1px solid var(--line); }
.tpa-article { max-width: 680px; margin: 0 auto; padding: 24px 18px 56px; }

/* Header */
