}

/* Buttons and CTAs */
.tpa-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 12px 26px; border: 0; border-radius: 999px; background: var(--accent); color: var(--ink); font: 700 17px/1.2 var(--sans); text-decoration: none; cursor: pointer; }
