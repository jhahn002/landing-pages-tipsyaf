/* Sticky CTA (phones) */
.tpa-sticky { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 7px 7px 7px 20px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 15px; box-shadow: 0 10px 30px rgba(0,0,0,.25); transform: translateY(160%); transition: transform .2s ease; }
